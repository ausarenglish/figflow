{
  "name": "figflow",
  "version": "0.4.0",
  "private": true,
  "description": "Carry Figma comments into your repo, and the result back to the designer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ausarenglish/figflow.git"
  },
  "type": "module",
  "bin": {
    "figflow": "./bin/figflow.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "skills",
    "examples",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test:live": "FIGFLOW_LIVE=1 node --test test/live.test.ts",
    "check": "npm run lint && npm test",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
